[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[submodule]
	active = .
[remote "origin"]
	url = https://github.com/luca-0118/condor-game.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[lfs]
	repositoryformatversion = 0
[branch "Main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "Google-prototype"]
	vscode-merge-base = origin/main
[branch "Google-proto-2"]
	remote = origin
	merge = refs/heads/Google-proto-2
